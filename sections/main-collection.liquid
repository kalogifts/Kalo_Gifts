{%- paginate collection.products by 24 -%}
<section class="sec">
  <div class="wrap">
    <div class="head">
      <h1>{{ collection.title }}</h1>
      <p>{{ collection.description | strip_html | truncate: 160 }}</p>
    </div>

    {%- if section.settings.show_chips and section.settings.chips_menu.links.size > 0 -%}
      <div class="chips" role="navigation" aria-label="Filter gifts">
        {%- for link in section.settings.chips_menu.links -%}
          <a class="chip" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <p class="meta">No products here yet. Check back soon.</p>
    {%- else -%}
      <div class="grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pager">
          {%- if paginate.previous -%}<a class="btn ghost" href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
          {%- if paginate.next -%}<a class="btn ghost" href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_chips", "label": "Show filter chips", "default": true },
    { "type": "link_list", "id": "chips_menu", "label": "Chips menu", "default": "main-menu", "info": "Create a menu (e.g. 'collection-chips') with your collections." }
  ]
}
{% endschema %}
