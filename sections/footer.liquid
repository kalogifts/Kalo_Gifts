<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <img src="{{ 'kalo-mark.webp' | asset_url }}" alt="KALO Gifts" width="64" height="64" loading="lazy">
        <p>{{ section.settings.tagline }}</p>
      </div>
      <div>
        <span class="label">Shop</span>
        {%- assign menu = section.settings.menu -%}
        {%- for link in menu.links -%}<p><a href="{{ link.url }}">{{ link.title }}</a></p>{%- endfor -%}
      </div>
      <div>
        <span class="label">Get in touch</span>
        {%- if settings.whatsapp_number != blank -%}
          <p>WhatsApp <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">+{{ settings.whatsapp_number | remove: '+' }}</a></p>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}<p><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>{%- endif -%}
        {%- if settings.instagram_handle != blank -%}<p><a href="https://instagram.com/{{ settings.instagram_handle }}" target="_blank" rel="noopener">Instagram @{{ settings.instagram_handle }}</a></p>{%- endif -%}
      </div>
    </div>
    <p class="legal small">Scripture quotations are from the ESV® Bible (The Holy Bible, English Standard Version®), © 2001 by Crossway, a publishing ministry of Good News Publishers. Used by permission. All rights reserved.</p>
    <div class="legal"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>Chennai, Tamil Nadu</span></div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Gifts with a message, made with faith in Chennai." },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" }
  ]
}
{% endschema %}
