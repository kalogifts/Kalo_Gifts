<section class="sec" style="padding-top:clamp(32px,4vw,56px)">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="head"><h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div>
    {%- endif -%}
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign title = block.settings.title | default: col.title -%}
        <a class="tile" href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="tile-art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 900px) 18vw, 45vw', alt: title }}
            {%- elsif col.image != blank -%}
              {{ col.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 900px) 18vw, 45vw', alt: title }}
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}
            {%- endif -%}
          </div>
          <b>{{ title }}</b>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "" },
    { "type": "text", "id": "heading_em", "label": "Heading (accent, italic)", "default": "" }
  ],
  "blocks": [
    { "type": "tile", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title (leave empty to use the collection name)" },
      { "type": "image_picker", "id": "image", "label": "Photo (leave empty to use the collection image)" },
      { "type": "select", "id": "icon", "label": "Icon when there is no photo", "default": "hamper", "options": [
        { "value": "hamper", "label": "Gift hamper" }, { "value": "tee", "label": "T-shirt" }, { "value": "hoodie", "label": "Hoodie" },
        { "value": "bottle", "label": "Bottle" }, { "value": "tote", "label": "Tote bag" }, { "value": "frame", "label": "Photo frame" } ] }
    ] }
  ],
  "presets": [ { "name": "Category tiles" } ]
}
{% endschema %}
