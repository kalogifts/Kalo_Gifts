<section class="sec{% if section.settings.dark %} dark{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="wrap">
    <div class="head">
      <div>{% if section.settings.label != blank %}<span class="label">{{ section.settings.label }}</span>{% endif %}<h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div>
      {%- assign col = section.settings.collection -%}
      {%- if col != blank -%}<a class="more" href="{{ col.url }}">View all</a>{%- endif -%}
    </div>
    {%- assign col = section.settings.collection -%}
    {%- if col != blank and col.products_count > 0 -%}
      <div class="grid">
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="meta">Choose a collection in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id (for menu links)", "default": "shop" },
    { "type": "text", "id": "label", "label": "Small label above heading" },
    { "type": "checkbox", "id": "dark", "label": "Dark green background", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts for" },
    { "type": "text", "id": "heading_em", "label": "Heading (gold italic)", "default": "everyone" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 9 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
