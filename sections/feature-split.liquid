<section class="sec">
  <div class="wrap">
    <div class="split{% if section.settings.flip %} flip{% endif %}">
      <div class="art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 860px) 45vw, 100vw', alt: section.settings.heading }}
        {%- else -%}
          {% render 'icon', name: section.settings.icon %}
        {%- endif -%}
      </div>
      <div class="copy">
        <span class="label">{{ section.settings.label }}</span>
        <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
        <p>{{ section.settings.text }}</p>
        {%- if section.settings.cta_label != blank -%}
          <a class="btn gold" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature (image + text)",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Handwritten" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A card in" },
    { "type": "text", "id": "heading_em", "label": "Heading (accent, italic)", "default": "every box" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us what to write and we'll handwrite your message on the gift card that goes inside." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop hampers" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "select", "id": "icon", "label": "Icon when there is no photo", "default": "hamper", "options": [
      { "value": "hamper", "label": "Gift hamper" }, { "value": "frame", "label": "Photo frame" }, { "value": "tee", "label": "T-shirt" }, { "value": "bottle", "label": "Bottle" } ] },
    { "type": "checkbox", "id": "flip", "label": "Photo on the right", "default": false }
  ],
  "presets": [ { "name": "Feature (image + text)" } ]
}
{% endschema %}
