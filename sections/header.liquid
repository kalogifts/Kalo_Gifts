<header class="top">
  <div class="wrap">
    <nav data-nav aria-label="Main">
      {%- assign menu = section.settings.menu -%}
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <a class="brand" href="{{ routes.root_url }}">
      <img src="{{ 'kalo-logo.webp' | asset_url }}" alt="" width="38" height="38">
      <b>{{ shop.name | default: 'KALO' | upcase | replace: ' GIFTS', '' }}</b>
    </a>
    <div class="right">
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false">Menu</button>
      <a class="bagbtn" href="{{ routes.cart_url }}">Bag <span class="count">{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
