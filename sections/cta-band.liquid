<section class="sec band">
  <div class="wrap">
    <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
    <p>{{ section.settings.text }}</p>
    {%- liquid
      assign wa = settings.whatsapp_number | remove: '+' | remove: ' '
      assign href = section.settings.link
      if href == blank and wa != blank
        assign msg = section.settings.wa_message | url_encode
        assign href = 'https://wa.me/' | append: wa | append: '?text=' | append: msg
      endif
    -%}
    {%- if href != blank -%}
      <div class="cta"><a class="btn gold" href="{{ href }}" target="_blank" rel="noopener">{{ section.settings.cta }} <span aria-hidden="true">→</span></a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Chat / contact band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want something" },
    { "type": "text", "id": "heading_em", "label": "Heading (accent, italic)", "default": "different?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us what you have in mind and we'll make it happen." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Chat on WhatsApp" },
    { "type": "text", "id": "wa_message", "label": "WhatsApp opening message", "default": "Hi KALO! I'd like to ask about a gift: " },
    { "type": "url", "id": "link", "label": "Button link", "info": "Leave empty to open WhatsApp using the number in theme settings." }
  ],
  "presets": [ { "name": "Chat / contact band" } ]
}
{% endschema %}
