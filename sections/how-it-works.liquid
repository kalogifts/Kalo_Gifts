<section class="sec" id="how">
  <div class="wrap how-grid">
    <div class="stick">
      <span class="idx">{{ section.settings.index }}</span>
      <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
    </div>
    <ol>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="idx">Step 0{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "index", "label": "Small label", "default": "(06) — How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple, personal," },
    { "type": "text", "id": "heading_em", "label": "Heading (gold italic)", "default": "honest." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Choose" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "How it works", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
