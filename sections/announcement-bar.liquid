<div class="announce" aria-label="Announcements">
  <div class="track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span {% if i == 2 %}aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 8,
  "blocks": [
    { "type": "message", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free handwritten gift card with every order" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free handwritten gift card with every order" } },
      { "type": "message", "settings": { "text": "Chennai delivery in 1–2 days" } },
      { "type": "message", "settings": { "text": "Packed by hand in Chennai" } },
      { "type": "message", "settings": { "text": "Gift hampers & office gifting" } },
      { "type": "message", "settings": { "text": "Order by 21 December for Christmas" } }
    ]
  }
}
{% endschema %}
