<div class="announce" role="region" aria-label="Announcements">
  <div class="wrap">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    { "type": "message", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Chennai delivery in 1–2 days" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free delivery above ₹1,000" } },
      { "type": "message", "settings": { "text": "Delivering across Chennai in 1–2 days and all over India" } },
      { "type": "message", "settings": { "text": "Handwritten gift card for ₹50" } }
    ]
  }
}
{% endschema %}
