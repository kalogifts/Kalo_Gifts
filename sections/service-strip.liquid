<div class="wrap">
  <div class="strip">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Service strip",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Chennai in 1–2 days" },
      { "type": "text", "id": "text", "label": "Text", "default": "Delivered to your door across Chennai." }
    ] }
  ],
  "presets": [ { "name": "Service strip", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
