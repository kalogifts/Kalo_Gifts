<section class="sec" id="faq">
  <div class="wrap">
    <div class="head">
      <span class="idx">{{ section.settings.index }}</span>
      <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
      <span></span>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary><span class="idx">0{{ forloop.index }}</span>{{ block.settings.question }}</summary>
          <div class="ans">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "index", "label": "Small label", "default": "(09) — Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good" },
    { "type": "text", "id": "heading_em", "label": "Heading (gold italic)", "default": "to know" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "faq" } ] } ]
}
{% endschema %}
